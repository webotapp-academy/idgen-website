# Postgres connection string (Neon/Supabase recommended — pairs with Drizzle).
# Not required for `npm run dev` / `npm run build`: content currently reads
# from src/data (typed to match src/db/schema.ts) until a database is
# provisioned. Fill this in and run `npm run db:push && npm run db:seed`
# to switch the app over to live data.
DATABASE_URL=

# Public site URL — used for canonical tags, sitemap.xml, and JSON-LD.
# Update once the production domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://www.idgen.in

# Contact form / quote request delivery target (used by src/app/get-a-quote).
LEADS_NOTIFY_EMAIL=
